  "info": {
    "_postman_id": "82dcb339-74b2-4df0-9a72-2c5199b4fe88",
    "name": "NASA Mars Rover Photos Manifests Rovers API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "REST API providing images captured by NASA's Curiosity, Opportunity, Spirit, and Perseverance Mars rovers. Photos can be queried by Martian sol (day since landing), Earth date, and camera type. Mission manifest data is available per rover with landing dates, launch dates, rover status, and per-sol photo breakdowns.\n\n\nContact Support:\n Name: NASA APIs Team",
      "type": "text/plain"
    }
  }
