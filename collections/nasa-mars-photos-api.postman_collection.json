  "item": [
    {
      "id": "e61616a1-9a2a-45ef-815b-4be516234a86",
      "name": "Photos",
      "description": {
        "content": "Retrieve rover photos filtered by sol, Earth date, and camera.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "145de1c0-309a-49a2-bc0f-8d2cf706a6d6",
          "name": "Get rover photos by sol or Earth date",
          "request": {
            "name": "Get rover photos by sol or Earth date",
            "description": {
              "content": "Retrieve photos taken by a Mars rover. Photos may be filtered by Martian sol, Earth date, and/or camera type. One of `sol` or `earth_date` is required.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rovers",
                ":rover",
                "photos"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "sol",
                  "value": "<integer>",
                  "description": "Martian rotation (sol) on which photos were taken, counting from the rover's landing date (sol 0). Cannot be combined with `earth_date`.\n"
                },
                {
                  "disabled": false,
                  "key": "earth_date",
                  "value": "<date>",
                  "description": "Earth date on which photos were taken, formatted as YYYY-MM-DD. The earliest date available is the rover's landing date. Cannot be combined with `sol`.\n"
                },
                {
                  "disabled": false,
                  "key": "camera",
                  "value": "<string>",
                  "description": "Filter photos by camera abbreviation. Not case sensitive. Valid values vary by rover; see documentation for per-rover camera tables.\n"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number of results (25 photos per page)."
                },
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "DEMO_KEY",
                  "description": "NASA API key. Use DEMO_KEY for testing."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "rover",
                  "description": "(Required) Name of the Mars rover."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "45a01faf-9d14-48a5-844e-2f973f66e3e9",
